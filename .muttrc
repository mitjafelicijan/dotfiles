# Layout
set pager_index_lines = 12
set pager_context = 3
set pager_stop = yes
set status_on_top = yes
set smart_wrap = yes
set wrap = 100
set markers = no
set help = no
set sidebar_visible = no
set arrow_cursor = no

# Cache
set header_cache = "~/.mutt/cache/headers"
set message_cachedir = "~/.mutt/cache/bodies"
set message_cache_clean = yes

# Message list
set index_format = "%Z %{%d %b %H:%M} %-24.24F %?M?[%M] ?%s"
set status_format = " %f | %m messages | %u unread"
set mark_old = no

# Conversation threading
set sort = reverse-threads
set sort_aux = last-date-received
set strict_threads = no
set collapse_unread = no
set uncollapse_jump = yes

# Automatically collapse conversations
folder-hook . "push <collapse-all>"

# Archive (Gmail Inbox only, verify behavior)
bind index,pager A purge-message

# Synchronization
set mail_check = 10
set timeout = 10
set imap_idle = yes
set imap_keepalive = 300
set beep_new = no

# Visible email headers
ignore *
unignore From To Cc Date Subject
unhdr_order *
hdr_order From To Cc Date Subject

# Ask before committing deletions
set delete = ask-yes

# Ask before quitting
set quit = ask-yes

# Don't include yourself when replying to everyone
set metoo = no

# Include attachments when forwarding
set mime_forward = ask-no

# Remember the last mailbox
set save_history = 100
set history_file = "~/.mutt/history"

# Info
set from = "mitja.felicijan@gmail.com"
set realname = "Mitja Felicijan"
set use_from = yes

# Credentials
source ~/.mutt/secrets

# IMAP
set imap_user = "mitja.felicijan@gmail.com"
set imap_pass = $imap_pass

# SMTP
set smtp_url = "smtps://mitja.felicijan@gmail.com@smtp.gmail.com:465/"
set smtp_pass = $smtp_pass

# Gmail folders
set folder = "imaps://imap.gmail.com/"
set spoolfile = "+INBOX"
set postponed = "+[Gmail]/Drafts"
set record = "+[Gmail]/Sent Mail"
set trash = "+[Gmail]/Trash"
